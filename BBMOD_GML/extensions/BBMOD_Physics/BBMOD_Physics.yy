        {"$GMExtensionFunction":"","%Name":"BBMOD_ConvexHull_CreateFromModel","argCount":0,"args":[1,],"documentation":"/// @desc Creates a convex hull collision shape from a BBMOD model.\n///\n/// Buffer format:\n/// - uint32_t meshCount\n/// - For each mesh:\n///   - uint32_t vertexCount\n///   - For each vertex:\n///     - double x, y, z\n/// - Node hierarchy (root):\n///   - double realX, realY, realZ, realW (dual quaternion real part)\n///   - double dualX, dualY, dualZ, dualW (dual quaternion dual part)\n///   - uint32_t meshIndexCount\n///   - For each mesh index:\n///     - uint32_t meshIndex\n///   - uint32_t childCount\n///   - For each child:\n///     - (recursive node structure)\n///\n/// @param _buffer Pointer to the buffer containing model data\n/// @return Shape ID on success, -1.0 on failure","externalName":"BBMOD_ConvexHull_CreateFromModel","help":"BBMOD_ConvexHull_CreateFromModel(_buffer)","hidden":false,"kind":4,"name":"BBMOD_ConvexHull_CreateFromModel","resourceType":"GMExtensionFunction","resourceVersion":"2.0","returnType":2,},
        {"$GMExtensionFunction":"","%Name":"BBMOD_ConvexHull_LoadFromFile","argCount":0,"args":[1,],"documentation":"/// @desc Loads a convex hull collision shape from a binary file.\n///\n/// @param _filepath Pointer to null-terminated string containing the file path\n/// @return Shape ID on success, -1.0 on failure","externalName":"BBMOD_ConvexHull_LoadFromFile","help":"BBMOD_ConvexHull_LoadFromFile(_filepath)","hidden":false,"kind":4,"name":"BBMOD_ConvexHull_LoadFromFile","resourceType":"GMExtensionFunction","resourceVersion":"2.0","returnType":2,},
        {"$GMExtensionFunction":"","%Name":"BBMOD_ConvexHull_SaveToFile","argCount":0,"args":[2,1,],"documentation":"/// @desc Saves a convex hull collision shape to a binary file.\n///\n/// @param _shapeId The ID of the convex hull shape to save\n/// @param _filepath Pointer to null-terminated string containing the file path\n/// @return 1.0 on success, -1.0 on failure","externalName":"BBMOD_ConvexHull_SaveToFile","help":"BBMOD_ConvexHull_SaveToFile(_shapeId, _filepath)","hidden":false,"kind":4,"name":"BBMOD_ConvexHull_SaveToFile","resourceType":"GMExtensionFunction","resourceVersion":"2.0","returnType":2,},
        {"$GMExtensionFunction":"","%Name":"BBMOD_HingeConstraint_EnableMotor","argCount":0,"args":[2,2,],"documentation":"","externalName":"BBMOD_HingeConstraint_EnableMotor","help":"BBMOD_HingeConstraint_EnableMotor(_constraintId, _enable)","hidden":false,"kind":4,"name":"BBMOD_HingeConstraint_EnableMotor","resourceType":"GMExtensionFunction","resourceVersion":"2.0","returnType":2,},
